PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://gm:gm_password@postgres:5432/gm_sound_manager

# Garage is S3-compatible. Credentials are NOT set via environment variables on
# the Garage side: they are generated by `garage key create` after the cluster
# layout is applied. See the "Local infrastructure" section of the README.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
