PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgresql://gm:gm_password@postgres:5432/gm_sound_manager

# Generate with: openssl rand -hex 32 (or any strong password)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# In dev, the root credentials above can be reused directly as the S3 access
# keys below. For a more restricted setup, create a dedicated user/policy via
# the MinIO Console (http://localhost:9001) or the `mc` CLI, then use those
# credentials here instead. See the "Bootstrapping MinIO" section of the README.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=audio
S3_ACCESS_KEY=
S3_SECRET_KEY=


POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_SECRET=
