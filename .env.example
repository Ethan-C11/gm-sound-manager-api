PORT=3000
HOST=0.0.0.0

# Generate each with: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

DATABASE_URL=postgresql://gm:gm_password@postgres:5432/gm_sound_manager

# Unlike the two secrets above, the S3 access keys cannot be chosen: Garage
# generates them via `garage key create`, once the cluster layout is applied.
# See the "Bootstrapping Garage" section of the README.
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET=audio
S3_ACCESS_KEY=
S3_SECRET_KEY=


POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

JWT_SECRET=